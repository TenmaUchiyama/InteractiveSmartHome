[
  {
    "id": "d8bac779-0d43-430b-9011-52868713e7cd",
    "text": "目の前の電気付けてください"
  },
  {
    "id": "8ec33bee-662a-44ca-8b72-d185da2f980a",
    "text": "えーと、後ろの 後ろの壁の右側の電気つけてくださーい"
  },
  {
    "id": "3a642a22-d8be-466d-ae3d-8ee4ae7e730f",
    "text": "と、今見えている電気つけてくださーい"
  },
  {
    "id": "c286155d-b180-4fbe-b367-de60d489486a",
    "text": "今見えてる中で手前を青色、 奥を赤色にして"
  },
  {
    "id": "ef939725-d1d9-4f96-8c1e-84439f9685ed",
    "text": "棚の真ん中の列の右二つをつけててください"
  },
  {
    "id": "7ab7ff90-5bd1-4f82-858a-dcc110e978db",
    "text": "後ろの真ん中の電気つけて くださーい"
  },
  {
    "id": "e5813fa8-3be0-4d47-bf14-6e995f2a7951",
    "text": "えっと、 棚の一番左の列全部付けてください。"
  },
  {
    "id": "7517acb0-0a93-4cd3-9b89-4aa747e3ea32",
    "text": "えっと、 一番左奥の天井の電気つけてくださーい"
  },
  {
    "id": "7067fd6d-160b-4aed-995d-72160cab090e",
    "text": "天井の一番向こうの列の左二つを電気付けてください。"
  },
  {
    "id": "eb0c17ca-5ab4-4a6d-b2eb-72974412f785",
    "text": "の電気の 左下の電気つけてくださーい"
  },
  {
    "id": "57c4ca5c-5e47-4b6c-aa58-66d939bdaf0f",
    "text": "俺の後ろの左側と右側の電気つけて"
  }
]