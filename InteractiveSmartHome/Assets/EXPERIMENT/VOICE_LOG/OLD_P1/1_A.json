[
  {
    "id": "3a642a22-d8be-466d-ae3d-8ee4ae7e730f",
    "text": "私から見て、天井の奥の一番右の連休と 左から二番目の電球をつけてください。"
  },
  {
    "id": "7ab7ff90-5bd1-4f82-858a-dcc110e978db",
    "text": "私の後輩にある三つのライトのうち、中央にあるライトを付けてください。"
  },
  {
    "id": "8ec33bee-662a-44ca-8b72-d185da2f980a",
    "text": "私ら前方にあるディスプレイの右側にあるライトを付けてください。"
  },
  {
    "id": "eb0c17ca-5ab4-4a6d-b2eb-72974412f785",
    "text": "今、私の視界に根付いてるライトのうち、最も飛騨にあるものを付けてください。"
  },
  {
    "id": "c286155d-b180-4fbe-b367-de60d489486a",
    "text": "司会の奥である三つないと赤色に手前の三つのライトを青色にして下さい。"
  },
  {
    "id": "e5813fa8-3be0-4d47-bf14-6e995f2a7951",
    "text": "棚にあるライトのうち、上、上部三つのライトをつけてください。"
  },
  {
    "id": "3e5150e3-4377-405c-b76b-ca076bc34f12",
    "text": "私の正面、真ん中にあるライトを付けてください。"
  },
  {
    "id": "7517acb0-0a93-4cd3-9b89-4aa747e3ea32",
    "text": "天井の左奥のライト、 白色に点灯してください。"
  },
  {
    "id": "7067fd6d-160b-4aed-995d-72160cab090e",
    "text": "天井の奥のライト、 左 から二つ点灯してください"
  },
  {
    "id": "57c4ca5c-5e47-4b6c-aa58-66d939bdaf0f",
    "text": "窓のライトのうち左手右を点灯してください。"
  },
  {
    "id": "ef939725-d1d9-4f96-8c1e-84439f9685ed",
    "text": "棚の中央と中央下段のライトを点灯してください"
  }
]