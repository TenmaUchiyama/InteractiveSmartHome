[
  {
    "id": "fa7f89d9-f7d0-4902-8450-e0895e620afc",
    "text": "左下を青に、右上を赤"
  },
  {
    "id": "a66cdb82-021a-4571-b637-df9cf9f2d492",
    "text": "三つともしろ"
  },
  {
    "id": "bf884966-5e80-4d77-a853-182f6f80451a",
    "text": "三つとも白 にー"
  },
  {
    "id": "6770ca4c-11ef-4253-9751-227343e96346",
    "text": "二つとも白く"
  },
  {
    "id": "a02be224-4d19-4683-b74b-724fa1dce9b9",
    "text": "二つとも白"
  },
  {
    "id": "9959b3ca-27c6-4c56-8b41-31879b574b9f",
    "text": "白くしてください。"
  },
  {
    "id": "f53f8140-6ae0-43aa-b58c-3126db7d2c9c",
    "text": "白くしてください"
  },
  {
    "id": "15030911-0df0-444c-8820-f0bee593553b",
    "text": "白くしてくださーい"
  },
  {
    "id": "885b5116-5ead-4aad-9d3c-ea0eff171e49",
    "text": "青くしてください"
  },
  {
    "id": "1663a1b8-f41a-4e44-bdf7-dc34c5b9027a",
    "text": "左を赤に右を青にしてくださーい"
  },
  {
    "id": "8eb57a85-1419-4838-9d8b-207b685d09df",
    "text": "左を青色に 右を赤色にして下さい。"
  },
  {
    "id": "8411e1bb-154e-43c4-978b-ead51a0920af",
    "text": "白くしてください"
  }
]