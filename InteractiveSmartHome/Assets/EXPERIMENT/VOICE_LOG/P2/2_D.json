[
  {
    "id": "6712e794-1692-4c29-84c4-473a541297ce",
    "text": "セイリングライト一二を付けてくだ"
  },
  {
    "id": "0556e598-8715-41f7-b179-b4449e0b994d",
    "text": "スタンドライト三を付けてください"
  },
  {
    "id": "0d254695-3fb2-40c1-8317-e7e6a265b570",
    "text": "セルフライト四、五、六を付けてください"
  },
  {
    "id": "62ba3e41-6526-4572-a06a-13d313dc9cb8",
    "text": "はい。 テーブルライトを赤いのにフロア ライトに 青色にしてください。"
  },
  {
    "id": "1be997cb-c0c6-4426-aa06-6c4b20d791ad",
    "text": "ティービーライト一応青にティービーライト二を赤にしてくだ"
  },
  {
    "id": "6c2d6213-8cca-47b5-a497-c8078e3df7e1",
    "text": "フロアライト一応赤色に スタンドラインと二を青色につけてください"
  },
  {
    "id": "3f64a507-9eeb-4de9-99a8-cc5b99cbfc5a",
    "text": "スタンドライト、一応青色に 二を赤色に付けてください。"
  },
  {
    "id": "dcb2ee97-24c8-47ed-b1c2-2b89f7f300e0",
    "text": "セルフライトを全部付けてください。"
  },
  {
    "id": "4ce91266-e46f-44c8-a184-fca8ac872733",
    "text": "ボールライトを全部青色につけてください。"
  },
  {
    "id": "fdeae907-962e-43d4-a4cf-441a4f8c06cc",
    "text": "ボールライトいちご赤い色につけてください"
  },
  {
    "id": "5419457b-2e8f-4fc8-837d-f5d92db30a2f",
    "text": "セルフライトなら九を赤色に付けてください。"
  },
  {
    "id": "6154739d-83cc-42d3-b6b2-d4a950b2acc6",
    "text": "シェイリングライト十二を付けてください"
  }
]