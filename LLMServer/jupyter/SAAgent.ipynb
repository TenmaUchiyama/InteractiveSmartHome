   "source": [
    "from langchain_core.messages import ToolMessage\n",
    "from pydantic import BaseModel, Field\n",
    "from langchain_core.output_parsers import JsonOutputParser\n",
    "from typing import Literal\n",
    "\n",
    "class FilterOutputData(BaseModel):\n",
    "    filter_type: Literal['sight', 'direction', 'object']\n",
    "    order: Literal['proximity', 'right', 'height']\n",
    "    devices: list\n",
    "\n",
    "\n",
    "parser = JsonOutputParser(pydantic_object=FilterOutputData)\n",
    "\n",
    "with open(\"./gp_filter_system_msg.txt\", \"r\", encoding=\"utf-8\") as f:\n",
    "    filter_message = SystemMessage(f.read())\n",
    "\n",
    "\n",
    "def filter_preprocess_node(state): \n",
    "    print(\"=========[FILTER]  PRE PROCESS ===========\")\n",
    "    input_msgs = [\n",
    "    filter_message, \n",
    "    state.user_prompt\n",
    "    ]\n",
    "\n",
    "\n",
    "    state.filterAgent.messages = input_msgs \n",
    "    return state\n",
    "\n",
    "\n",
    "def filter_agent_node(state): \n",
    "    print(\"=========[FILTER] AGENT===========\")\n",
    "    \n",
    "    agent_res = filter_agent.invoke(state.filterAgent.messages)\n",
    "    print(agent_res)\n",
    "    state.filterAgent.messages.append(agent_res) \n",
    "    return state\n",
    "    \n",
    "\n",
    "def filter_tool_node(state):\n",
    "    last_message = state.filterAgent.messages[-1]\n",
    "\n",
    "    new_messages = []  \n",
    "    \n",
    "    if len(last_message.tool_calls) == 0: \n",
    "       \n",
    "        state.filterAgent.messages.append(\n",
    "        ToolMessage(\n",
    "            content=f\"No tool call found, Please Try it again\", \n",
    "            tool_call_id=\"0\"\n",
    "            )\n",
    "        )\n",
    "        \n",
    "    t  = last_message.tool_calls[0] \n",
    "    tool_function= filter_tool_map[t[\"name\"]]\n",
    "    tool_output = tool_function.invoke(t[\"args\"])\n",
    "    state.filterAgent.devices =  tool_output['devices']\n",
    "\n",
    "    print(tool_output)\n",
    "    state.filterAgent.messages.append(\n",
    "    ToolMessage(\n",
    "        content=f\"Received: {'Successfully Get the All Device Data' if tool_output['status'] == 'success' else 'FAILED'}\", \n",
    "        tool_call_id=t[\"id\"]\n",
    "        )\n",
    "    )\n",
    "\n",
    "    print(\"TOOL DEVICE:\", tool_output['devices'])\n",
    "    print(\"state device: \", state.filterAgent.devices)\n",
    "    return state\n",
    "\n",
    "\n",
    "def filter_postprocess_node(state):\n",
    "    print(\"=========[FILTER]  POST PROCESS ===========\")\n",
    "    last_msg =  state.filterAgent.messages[-1]\n",
    "    output = parser.invoke(last_msg.content)\n",
    "    print(\"フォーマットする: \", output)\n",
    "    state.filterAgent.final_output = output\n",
    "    return state\n",
    "\n",
    "def filter_router(state): \n",
    "    last_message = state.filterAgent.messages[-1]\n",
    "  \n",
    "    if last_message.tool_calls: \n",
    "        print(\"ツールを呼ぶ\")\n",
    "        return NODE.FILTER_TOOL.value\n",
    "    else: \n",
    "        print(\"ツールは呼ばない\")\n",
    "        return NODE.FILTER_POSTPROCESS.value"
   ]
  },
